
# ============================================================
# BismiLLAH (2026-09-23) — NEW ENVIRONMENT VARIABLES (appended per protocol)
# ============================================================

# --- BirrPay Payment Gateway (inline checkout) ---
# Why: BirrPay is added alongside Paystack/Flutterwave (gateway='birrpay').
# The backend creates a BirrPay checkout session and the browser opens the
# BirrPay INLINE iframe widget — users are NEVER redirected to a hosted page.
# If BIRRPAY_SECRET_KEY is not set: gateway='birrpay' requests fail with a
# clear 502 "not configured" error; Paystack/Flutterwave keep working.
# BIRRPAY_BASE_URL — BirrPay API origin (AppSail deployment).
BIRRPAY_BASE_URL=https://birrpay-10133349281.development.catalystappsail.com
# BIRRPAY_SECRET_KEY — BirrPay app secret key (sk_test_…/sk_live_…). SERVER-SIDE ONLY.
BIRRPAY_SECRET_KEY=
# BIRRPAY_PUBLIC_KEY — BirrPay app publishable key (pk_…). Safe for the browser.
BIRRPAY_PUBLIC_KEY=
# BIRRPAY_WEBHOOK_SECRET — whsec_… verifying BirrPay webhook HMAC signatures
# (POST /api/payments/webhook). If not set, BirrPay webhooks are REJECTED (401).
BIRRPAY_WEBHOOK_SECRET=

# --- Gmail SMTP (App Password) — transactional email transport ---
# Why: the email service prefers Gmail API (OAuth2) when GMAIL_CLIENT_ID/
# SECRET/REFRESH_TOKEN are all set, and otherwise falls back to Gmail SMTP
# with an App Password — the lightweight production path on AppSail.
# If neither path is configured: emails are logged as "(dev) would send" and
# NOT delivered (bookings/orders/verifications still work end-to-end).
# GMAIL_USER — Gmail address used for SMTP login.
GMAIL_USER=
# GMAIL_APP_PASSWORD — Gmail App Password (16 chars, spaces allowed).
GMAIL_APP_PASSWORD=
