# =================================================
# CareConnect Platform Environment Variables
# =================================================
# Bismillah Ar-Rahman Ar-Raheem.
#
# Copy this file to `.env` (root, for frontend) AND `apps/backend/.env`
# (for the Astro backend). Both are gitignored — never commit secrets.
#
# The platform uses Lightbase (cloud DB) as the PRIMARY storage provider,
# with better-sqlite3 as an env-switchable fallback.

# ==========================================================
# STORAGE PROVIDER (backend — apps/backend/.env)
# ==========================================================
# 'lightbase' = Lightbase cloud DB via /api/v1 (PRIMARY, production)
# 'sqlite'    = better-sqlite3 local file DB (fallback, offline dev)
STORAGE_PROVIDER=lightbase

# Lightbase cloud DB credentials (server-side only — NEVER expose to client)
LIGHTBASE_API_KEY=lb_live_your_api_key_here
LIGHTBASE_PROJECT_ID=careconnect
LIGHTBASE_TENANT=default
LIGHTBASE_BASE_URL=http://lightbase.80.225.189.74.sslip.io

# Backend session signing secret (HMAC-SHA256) — generate a strong random string
SESSION_SECRET=generate_a_strong_random_secret_here

# Seed endpoint protection key (POST /api/seed requires this)
SEED_KEY=cc_seed_dev_key_change_in_production

# CORS origin for the SPA frontend (* for dev, specific origin for prod)
CORS_ORIGIN=*

# ==========================================================
# FRONTEND (root .env — loaded by Vite)
# ==========================================================

# --- Database Mode ---
# 'api'       = route through Astro backend (used for BOTH lightbase & sqlite) [DEFAULT/PRIMARY]
# 'github'    = client-side GitHub JSON DB (legacy fallback, no backend needed)
# 'sqlite'    = alias for 'api' (backward compat)
# 'lightbase' = alias for 'api' (backward compat)
VITE_DB_MODE=api

# --- Backend API URL ---
# Relative path in dev (Vite proxies /api -> localhost:4321).
# In production, set to your backend origin.
VITE_API_BASE_URL=/api

# --- Payment Gateway (PUBLIC keys only — safe for browser) ---
# Paystack public key (get from https://dashboard.paystack.com)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# --- Google Maps API Key ---
# Required for map-based directory views
# Get your API key from: https://developers.google.com/maps/documentation/javascript/get-api-key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Gemini API Keys (AI features) ---
# For AI-powered features (Health Tools, AI Support Agent, AILab)
# IMPORTANT: for production, route AI through backend /api/ai/* and leave these
# empty so the key stays server-side. Client-side keys are for dev only.
# Multiple keys can be comma-separated for load balancing.
VITE_GEMINI_API_KEYS=
VITE_GEMINI_API_KEY=

# --- Cloudinary Configuration ---
# For media and image uploads
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# --- Email (server-side; client vars below are legacy SMTPjs) ---
# For production, email is sent via the backend /api/email/send endpoint.
# These client-side vars are only used by the legacy SMTPjs path (dev fallback).
VITE_GMAIL_USER=your_gmail_address@gmail.com
VITE_GMAIL_PASSWORD=your_gmail_app_password

# --- GitHub DB SDK Configuration (legacy — only needed if VITE_DB_MODE=github) ---
VITE_GITHUB_OWNER=your_github_username
VITE_GITHUB_REPO=your_github_repo_name
VITE_GITHUB_TOKEN=your_github_personal_access_token

# --- Development Server Configuration ---
# HTTPS/SSL control for local dev (keep false in sandbox/HTTP environments)
VITE_DEV_SERVER_HTTPS=false

# --- Console / Dev Tools ---
# Set to 'true' to disable the in-app developer console
VITE_DISABLE_CONSOLE=
# Set to 'true' to explicitly enable the in-app developer console
VITE_ENABLE_CONSOLE=
