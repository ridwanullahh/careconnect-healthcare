{
  "name": "careconnect-healthcare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CareConnect Healthcare Platform - Comprehensive healthcare ecosystem",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:http": "VITE_FORCE_HTTP=true vite",
    "dev:backend": "cd apps/backend && bun run dev",
    "dev:all": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "build:analyze": "tsc && vite build --mode analyze",
    "build:backend": "npm run build --workspace=apps/backend",
    "lint": "eslint . --ext ts,tsx",
    "preview": "vite preview",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:backup": "cp data/careconnect.db data/careconnect.backup.$(date +%Y%m%d%H%M%S).db"
  },
  "dependencies": {
    "@esbuild/linux-arm64": "^0.21.5",
    "@react-google-maps/api": "^2.20.7",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.263.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.8.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "esbuild-wasm": "^0.28.1",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "terser": "^5.43.1",
    "typescript": "^5.0.2",
    "vite": "^5.4.21"
  }
}
