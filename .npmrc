# Bismillah Ar-Rahman Ar-Raheem.
# Ensure devDependencies are installed even in production build environments,
# because the build step (tsc + vite build) requires them. Some deployment
# pipelines run `npm ci --production` which would strip them and break the build.
# Setting legacy-peer-deps also avoids peer-resolution failures with React 18.
legacy-peer-deps=true
